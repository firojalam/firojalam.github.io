{% if site.google_site_verification or site.bing_site_verification %}
  <!-- Website verification -->
  {% if site.google_site_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.bing_site_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% capture title %}{{ author_name | strip }}{% endcapture %}

{% assign is_blog_post = false %}
{% if page.layout == 'post' and page.url != '/blog/index.html' and page.url != '/blog/' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}
{% assign is_homepage = false %}
{% if page.url == '/' or page.url == '/index.html' %}
  {% assign is_homepage = true %}
{% endif %}

{% capture content_description %}
  {{ page.content | markdownify | strip_html | strip_newlines | replace: '  ', ' ' | strip | truncate: 180 }}
{% endcapture %}

{% if page.seo_description != blank %}
  {% capture raw_description %}{{ page.seo_description }}{% endcapture %}
{% elsif is_homepage %}
  {% capture raw_description %}{{ site.description }}{% endcapture %}
{% elsif page.url == '/news/' or page.url == '/news/index.html' %}
  {% capture raw_description %}Research news, invited talks, shared tasks, workshop activities, grants, and paper highlights from Firoj Alam and collaborators.{% endcapture %}
{% elsif page.url == '/blog/' or page.url == '/blog/index.html' %}
  {% capture raw_description %}Blog posts on large language models, Arabic NLP, multimodal AI, fact-checking, propaganda detection, and low-resource language research.{% endcapture %}
{% elsif page.url == '/publications/' or page.url == '/publications/index.html' %}
  {% capture raw_description %}Research publications by Firoj Alam spanning LLMs, multimodal AI, speech processing, fact-checking, crisis informatics, and low-resource languages.{% endcapture %}
{% elsif page.url == '/projects/' or page.url == '/projects/index.html' %}
  {% capture raw_description %}Research projects, grants, and initiatives led or contributed to by Firoj Alam across LLM benchmarking, disinformation analysis, speech, and multimodal AI.{% endcapture %}
{% elsif page.url == '/repositories/' or page.url == '/repositories/index.html' %}
  {% capture raw_description %}Curated GitHub and Hugging Face repositories, datasets, models, demos, and code releases related to LLMs, multimodal AI, Arabic NLP, and crisis computing.{% endcapture %}
{% elsif page.url == '/people/' or page.url == '/people/index.html' %}
  {% capture raw_description %}Students, collaborators, postdocs, research assistants, and mentorship activities associated with Firoj Alam's research and project supervision.{% endcapture %}
{% elsif page.url == '/events/' or page.url == '/events/index.html' %}
  {% capture raw_description %}Shared tasks, workshops, tutorials, conference roles, and BoF sessions organized by Firoj Alam across NLP, multilingual AI, and multimodal research communities.{% endcapture %}
{% elsif page.url == '/cv/' or page.url == '/cv/index.html' %}
  {% capture raw_description %}Curriculum vitae of Firoj Alam, including research appointments, publications, grants, service, teaching, talks, and professional activities.{% endcapture %}
{% elsif page.url contains '/blog/tag/' %}
  {% capture raw_description %}Posts tagged {{ page.title }} on LLMs, NLP, speech processing, multimodal AI, and disinformation research by Firoj Alam.{% endcapture %}
{% elsif page.url contains '/blog/category/' %}
  {% capture raw_description %}Blog posts in the {{ page.title }} category covering multilingual NLP, multimodal AI, evaluation, and misinformation research by Firoj Alam.{% endcapture %}
{% elsif page.url == '/404.html' %}
  {% capture raw_description %}The requested page could not be found on the Firoj Alam website. Browse publications, projects, repositories, events, news, or the CV from the main navigation instead.{% endcapture %}
{% elsif page.url contains '/projects/' and content_description != blank %}
  {% assign raw_description = content_description %}
{% elsif page.url contains '/news/' and content_description != blank %}
  {% assign raw_description = content_description %}
{% elsif is_blog_post and content_description != blank %}
  {% assign raw_description = content_description %}
{% elsif page.description != blank %}
  {% capture raw_description %}{{ page.description }}{% endcapture %}
{% else %}
  {% capture raw_description %}{{ site.description }}{% endcapture %}
{% endif %}
{% assign meta_description = raw_description | markdownify | strip_html | strip_newlines | replace: '  ', ' ' | strip | truncate: 180 %}

{% if page.seo_title != blank %}
  {% capture meta_title %}{{ page.seo_title }} | {{ title }}{% endcapture %}
{% elsif is_homepage %}
  {% capture meta_title %}{{ title }} | LLMs, NLP, Speech, and Disinformation Research{% endcapture %}
{% elsif page.url == '/publications/' or page.url == '/publications/index.html' %}
  {% capture meta_title %}Publications and Research Articles | {{ title }}{% endcapture %}
{% elsif page.url == '/projects/' or page.url == '/projects/index.html' %}
  {% capture meta_title %}Research Projects, Grants, and Initiatives | {{ title }}{% endcapture %}
{% elsif page.url == '/repositories/' or page.url == '/repositories/index.html' %}
  {% capture meta_title %}Repositories, Datasets, and Code | {{ title }}{% endcapture %}
{% elsif page.url == '/events/' or page.url == '/events/index.html' %}
  {% capture meta_title %}Events, Workshops, and Shared Tasks | {{ title }}{% endcapture %}
{% elsif page.url == '/news/' or page.url == '/news/index.html' %}
  {% capture meta_title %}News, Talks, and Research Updates | {{ title }}{% endcapture %}
{% elsif page.url == '/blog/' or page.url == '/blog/index.html' %}
  {% capture meta_title %}Blog on LLMs, NLP, Speech, and Disinformation | {{ title }}{% endcapture %}
{% elsif page.url == '/people/' or page.url == '/people/index.html' %}
  {% capture meta_title %}Students, Collaborators, and Mentoring | {{ title }}{% endcapture %}
{% elsif page.url == '/cv/' or page.url == '/cv/index.html' %}
  {% capture meta_title %}Curriculum Vitae and Research Profile | {{ title }}{% endcapture %}
{% elsif page.url contains '/blog/tag/' %}
  {% capture meta_title %}Blog posts tagged {{ page.title }} | {{ title }}{% endcapture %}
{% elsif page.url contains '/blog/category/' %}
  {% capture meta_title %}Blog posts in {{ page.title }} | {{ title }}{% endcapture %}
{% elsif page.url contains '/blog/' and is_blog_post == false %}
  {% if page.title != blank %}
    {% capture meta_title %}Blog archive {{ page.title }} | {{ title }}{% endcapture %}
  {% else %}
    {% capture meta_title %}Blog archive | {{ title }}{% endcapture %}
  {% endif %}
{% elsif page.url contains '/news/' %}
  {% capture meta_title %}{{ page.title }} | News | {{ title }}{% endcapture %}
{% elsif is_blog_post %}
  {% capture meta_title %}{{ page.title }} | Blog | {{ title }}{% endcapture %}
{% elsif page.url contains '/projects/' %}
  {% capture meta_title %}{{ page.title }} | Research Project | {{ title }}{% endcapture %}
{% elsif page.url == '/404.html' %}
  {% capture meta_title %}Page not found on the {{ title }} website{% endcapture %}
{% elsif page.title != blank %}
  {% capture meta_title %}{{ page.title }} | {{ title }}{% endcapture %}
{% else %}
  {% capture meta_title %}{{ title }}{% endcapture %}
{% endif %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ meta_title }}</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ meta_description }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}

{% if page.noindex %}
  <meta name="robots" content="noindex, nofollow">
{% else %}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{% endif %}

{% if site.serve_og_meta %}
  {% assign og_image_url = page.og_image | default: site.og_image %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ title }}">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ meta_title }}">
  <meta property="og:url" content="{{ page.url | replace:'index.html','' | absolute_url }}">
  <meta property="og:description" content="{{ meta_description }}">
  {% if og_image_url %}
    {% if og_image_url contains '://' %}
      <meta property="og:image" content="{{ og_image_url }}">
    {% else %}
      <meta property="og:image" content="{{ og_image_url | absolute_url }}">
    {% endif %}
  {% endif %}
  <meta property="og:locale" content="{{ site.lang }}">

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ meta_title }}">
  <meta name="twitter:description" content="{{ meta_description }}">
  {% if og_image_url %}
    {% if og_image_url contains '://' %}
      <meta name="twitter:image" content="{{ og_image_url }}">
    {% else %}
      <meta name="twitter:image" content="{{ og_image_url | absolute_url }}">
    {% endif %}
  {% endif %}
  {% if site.x_username %}
    <meta name="twitter:site" content="@{{ site.x_username }}">
    <meta name="twitter:creator" content="@{{ site.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {% comment %} Social links generator for "sameAs schema" {% endcomment %}
  {% assign sameaslinks = '' | split: ',' %}
  {% if site.orcid_id %}
    {% capture link %}https://orcid.org/{{ site.orcid_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.scholar_userid %}
    {% capture link %}https://scholar.google.com/citations?user={{ site.scholar_userid }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.semanticscholar_id %}
    {% capture link %}https://www.semanticscholar.org/author/{{ site.semanticscholar_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.publons_id %}
    {% capture link %}https://publons.com/a/{{ site.publons_id }}/{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.lattes_id %}
    {% capture link %}http://lattes.cnpq.br/{{ site.lattes_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.osf_id %}
    {% capture link %}https://osf.io/{{ site.osf_id }}/{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.research_gate_profile %}
    {% capture link %}https://www.researchgate.net/profile/{{site.research_gate_profile}}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.scopus_id %}
    {% capture link %}https://www.scopus.com/authid/detail.uri?authorId={{site.scopus_id}}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.github_username %}
    {% capture link %}https://github.com/{{ site.github_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.telegram_username %}
    {% capture link %}https://telegram.me/{{ site.telegram_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.linkedin_username %}
    {% capture link %}https://www.linkedin.com/in/{{ site.linkedin_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.x_username %}
    {% capture link %}https://twitter.com/{{ site.x_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.mastodon_username %}
    {% capture link %}https://{{ site.mastodon_username  }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.medium_username %}
    {% capture link %}https://medium.com/@{{ site.medium_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.quora_username %}
    {% capture link %}https://www.quora.com/profile/{{ site.quora_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.blogger_url %}
    {% capture link %}{{ site.blogger_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.work_url %}
    {% capture link %}{{ site.work_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.wikidata_id %}
    {% capture link %}https://www.wikidata.org/wiki/{{ site.wikidata_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.wikipedia_id %}
    {% capture link %}https://wikipedia.org/wiki/User:{{ site.wikipedia_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.strava_userid %}
    {% capture link %}https://www.strava.com/athletes/{{ site.strava_userid }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.keybase_username %}
    {% capture link %}https://keybase.io/{{ site.keybase_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.gitlab_username %}
    {% capture link %}https://gitlab.com/{{ site.gitlab_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.dblp_url %}
    {% capture link %}{{ site.dblp_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.stackoverflow_id %}
    {% capture link %}https://stackoverflow.com/users/{{ site.stackoverflow_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.kaggle_id %}
    {% capture link %}https://www.kaggle.com/{{ site.kaggle_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.lastfm_id %}
    {% capture link %}https://www.last.fm/user/{{ site.lastfm_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.spotify_id %}
    {% capture link %}https://open.spotify.com/user/{{ site.spotify_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.pinterest_id %}
    {% capture link %}https://www.pinterest.com/{{ site.pinterest_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.unsplash_id %}
    {% capture link %}https://unsplash.com/@{{ site.unsplash_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.instagram_id %}
    {% capture link %}https://instagram.com/{{ site.instagram_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.facebook_id %}
    {% capture link %}https://facebook.com/{{ site.facebook_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.youtube_id %}
    {% capture link %}https://youtube.com/@{{ site.youtube_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.discord_id %}
    {% capture link %}https://discord.com/users/{{ site.discord_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if site.zotero_username %}
    {% capture link %}https://www.zotero.org/{{ site.zotero_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if is_homepage %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "{{ author_name }}",
        "url": "{{ page.url | replace:'index.html','' | absolute_url }}",
        "description": {{ meta_description | jsonify }}{% if sameaslinks.size > 0 %},
        "sameAs": {{ sameaslinks | jsonify }}{% endif %}
      }
    </script>
  {% elsif is_blog_post %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": "{% if page.title %}{{ page.title }}{% else %}{{ title }}{% endif %}",
        "url": "{{ page.url | replace:'index.html','' | absolute_url }}",
        "description": {{ meta_description | jsonify }},
        "author": {
          "@type": "Person",
          "name": "{{ author_name }}"
        }
      }
    </script>
  {% else %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "{% if page.title %}{{ page.title }}{% else %}{{ title }}{% endif %}",
        "url": "{{ page.url | replace:'index.html','' | absolute_url }}",
        "description": {{ meta_description | jsonify }}
      }
    </script>
  {% endif %}
{% endif %}
